# ─────────────────────────────────────────────────────────────
# MÉTÉO ACADEMY — variables d'environnement
# Copier ce fichier en « .env.local » puis compléter les valeurs.
# Ne jamais committer « .env.local » sur GitHub.
# ─────────────────────────────────────────────────────────────

# Adresse publique du site (utilisée pour le SEO, le sitemap et Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse recevant les messages du formulaire de contact
NEXT_PUBLIC_CONTACT_EMAIL=

# Activer l'achat des formations premium (« true » uniquement après branchement de la passerelle)
NEXT_PUBLIC_PAIEMENT_ACTIF=false

# ── Supabase (à renseigner après création du projet, voir README.md) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé serveur Supabase : à utiliser uniquement côté serveur, jamais exposée au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (à renseigner lors de l'intégration du paiement) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
